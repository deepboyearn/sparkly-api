{
  "name": "sparkly-api",
  "version": "1.2.0",
  "private": true,
  "description": "Tauri + React local OpenAI-compatible bridge proxy, dashboard, and automation CLI.",
  "bin": {
    "sparkly": "scripts/sparkly-cli.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cli": "node scripts/sparkly-cli.mjs",
    "cli:test": "node --test scripts/sparkly-cli.test.mjs",
    "dev:test": "node --test scripts/dev.test.mjs",
    "build:renderer": "vite build",
    "build": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev.mjs",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@tauri-apps/api": "^2",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.38.0",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.76.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.1"
  }
}
