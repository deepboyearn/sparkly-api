{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparkly API",
  "version": "1.2.0",
  "identifier": "com.sparklyapi.sparklyapi",
  "build": {
    "devUrl": "http://127.0.0.1:9",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sparkly API",
        "width": 1400,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 760,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' http://localhost:48231"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo.png",
      "icons/logo.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/logo.ico"
      }
    }
  }
}
